{
  "name": "bananadev",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Formação autodidata open source em Análise e Desenvolvimento de Sistemas.",
  "license": "MIT",
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run curriculum:generate && astro build",
    "preview": "astro preview",
    "curriculum:generate": "tsx scripts/generate-curriculum.ts",
    "curriculum:check": "tsx scripts/generate-curriculum.ts --check",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run build && npm run test:e2e",
    "audit:links": "tsx scripts/audit-links.ts"
  },
  "dependencies": {
    "astro": "^5.16.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@astrojs/sitemap": "^3.6.0",
    "@playwright/test": "^1.57.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
