/*
  # Security Headers for Cloudflare Pages
  # Applied to all responses

  # Prevent MIME type sniffing
  X-Content-Type-Options: nosniff

  # Prevent clickjacking
  X-Frame-Options: DENY

  # Control referrer information
  Referrer-Policy: strict-origin-when-cross-origin

  # Restrict browser features
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()

  # Enforce HTTPS (HSTS) - 1 year, include subdomains, preload
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Content Security Policy
  # Allow inline theme initialization script via hash
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-hrxQKvPgpwcVus/1HgYKOM14frF36SuBj1mhLolL2rk=' 'sha256-CcfhSX2dw1yOUsaJJN00+JUGp8pKw3ES3H8VQ4sH2Aw='; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

/brand/*
  # Allow caching for brand assets
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  # Allow caching for fonts
  Cache-Control: public, max-age=31536000, immutable

/_astro/*
  # Allow caching for built assets
  Cache-Control: public, max-age=31536000, immutable