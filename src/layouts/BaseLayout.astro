---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { SITE, url } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  canonicalPath?: string;
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description = SITE.description,
  type = 'website',
  noindex = false,
  canonicalPath,
  structuredData,
} = Astro.props;

const pageTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.subtitle}`;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
const ogImage = new URL(url('/og.png'), Astro.site).toString();

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  alternateName: '##BananaDev',
  url: new URL(url('/'), Astro.site).toString(),
  description: SITE.description,
  inLanguage: 'pt-BR',
  license: `${SITE.repo}/blob/main/LICENSE`,
  isAccessibleForFree: true,
  ...structuredData,
};
---

<!doctype html>
<html lang="pt-BR" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta name="theme-color" content="#fbf7ed" />
    <meta name="color-scheme" content="light dark" />
    <meta name="author" content={SITE.author} />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" href={url('/favicon.ico')} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={url('/brand/favicon-32.png')} />
    <link rel="apple-touch-icon" href={url('/brand/apple-touch-icon.png')} />
    <link rel="manifest" href={url('/manifest.webmanifest')} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="#BananaDev: uma banana desenvolvedora diante do computador" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <div class="sr-only" role="status" aria-live="polite" data-live-region></div>

    <button class="to-top" type="button" data-to-top data-visible="false" aria-label="Voltar ao topo">
      <Icon name="arrow-up" size={18} />
    </button>

    <script>
      import { initShell } from '../scripts/nav';
      initShell();
    </script>
  </body>
</html>
